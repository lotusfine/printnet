# PrintNet backend — variables de entorno
# NUNCA commitear este archivo con valores reales (.env está en .gitignore).

# --- MercadoPago Checkout Pro ---
# Sin MP_ACCESS_TOKEN el sistema cae al modo "fantasma" de Fase 1 (todo pedido
# nace pagado) — útil para desarrollo local sin credenciales.
# Credenciales de PRUEBA primero: https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN=
# Clave secreta del webhook (se genera al configurar la notificación en el
# panel de desarrolladores de MP) — valida la firma x-signature
MP_WEBHOOK_SECRET=
# URL pública del backend (Cloudflare Tunnel en dev, dominio real en prod).
# Con ella se construye la notification_url de las preferencias en runtime.
BASE_URL_PUBLICA=
# URL del frontend para las back_urls de Checkout Pro (/estado/{token})
PRINTNET_FRONTEND_URL=http://localhost:5173

# --- Panel de administración ---
# Token que exige /admin/*. Sin esto el panel NO abre (responde 503): se falla
# cerrado a propósito. Mínimo 16 caracteres.
# Generar uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PRINTNET_ADMIN_TOKEN=

# --- SMTP (si PRINTNET_SMTP_HOST está vacío, los emails se simulan y loggean) ---
PRINTNET_SMTP_HOST=
PRINTNET_SMTP_PORT=587
PRINTNET_SMTP_USER=
PRINTNET_SMTP_PASSWORD=
PRINTNET_SMTP_FROM=pedidos@printnet.local
PRINTNET_SMTP_STARTTLS=1

# --- Rutas (defaults: junto al código) ---
# PRINTNET_DB=/ruta/a/printnet.db
# PRINTNET_UPLOADS=/ruta/a/uploads

# --- Dispatch de impresión: simulated | sumatra | (futuro: cups) ---
# simulated: registra la intención sin tocar hardware. Es el default y es lo
#            que corre en las máquinas de desarrollo.
# sumatra:   imprime de verdad en Windows. Requiere PRINTNET_SUMATRA.
PRINTNET_DISPATCH=simulated
# Ruta al ejecutable de SumatraPDF (solo si PRINTNET_DISPATCH=sumatra).
# Default: C:\PrintNet\SumatraPDF.exe
# PRINTNET_SUMATRA=C:\PrintNet\SumatraPDF.exe

# --- CORS extra para producción (coma-separados); *.vercel.app ya está permitido ---
# PRINTNET_CORS_ORIGINS=http://localhost:5173,https://midominio.com

# --- URL pública para armar el link de seguimiento en los emails ---
# PRINTNET_PUBLIC_URL=https://api.midominio.com
